{
    "name": "fayne/laravel-filament-qrcode",
    "description": "QR code generation for Laravel and Filament.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "illuminate/support": "^13.0",
        "filament/filament": "^5.0",
        "endroid/qr-code": "^5.1",
        "overtrue/laravel-wechat": "^8.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-arch": "^4.0",
        "spatie/laravel-permission": "^6.0",
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint --test",
        "format:fix": "pint",
        "analyse": "phpstan analyse"
    },
    "autoload": {
        "psr-4": {
            "Fayne\\QrCode\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fayne\\QrCode\\QrcodeServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
